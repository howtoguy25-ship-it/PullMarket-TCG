{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://pullmarkettcg.com",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "878738587499-f1m1h9scgone6mb3md478ikqj4qlbed2.apps.googleusercontent.com",
        "EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY": ""
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://pullmarkettcg.com",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "878738587499-f1m1h9scgone6mb3md478ikqj4qlbed2.apps.googleusercontent.com",
        "EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY": ""
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://pullmarkettcg.com",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "878738587499-f1m1h9scgone6mb3md478ikqj4qlbed2.apps.googleusercontent.com",
        "EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY": ""
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "your-apple-id@example.com",
        "ascAppId": "REPLACE_WITH_APP_STORE_CONNECT_APP_ID",
        "appleTeamId": "REPLACE_WITH_APPLE_TEAM_ID"
      },
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "internal"
      }
    }
  }
}
