# ── Database ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pokeonepiece

# ── Auth / sessions ─────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string

# The one phone number (E.164) that gets access to the Owner Panel.
OWNER_PHONE_NUMBER=+61474011265
# Optional: also gate the owner panel to a specific email once you add one.
OWNER_EMAIL=

# ── Stripe (required for real payments/payouts) ────────────────────────
# Get these from https://dashboard.stripe.com/apikeys — use the sk_test_/pk_test_
# pair while building, switch to sk_live_/pk_live_ only when you're ready to
# accept real money. Connect must be enabled on your Stripe account for
# seller payouts (Stripe Dashboard → Connect → Get started).
STRIPE_SECRET_KEY=
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Flat platform fee added to every order, in cents. 299 = $2.99.
PLATFORM_FEE_CENTS=299
# Real address-search autocomplete in the native checkout's AddressSheet.
# iOS gets this for free from Apple's on-device completer — leave blank.
# Android needs a Google Places API key (console.cloud.google.com → enable
# "Places API" → create a key) or Android checkout works without
# autocomplete suggestions while typing.
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=

# ── PullMarket Pro membership ($19.99/mo) ────────────────────────────────
# Web purchases go through Stripe (created automatically the first time
# anyone hits the checkout route — no manual Stripe Dashboard setup
# needed). The native iOS app instead uses real Apple In-App Purchase,
# which Apple requires for subscriptions that unlock in-app features —
# see server/src/lib/appleSubscription.ts. To enable it:
#   1. App Store Connect → your app → Subscriptions → create a
#      Subscription Group, then an auto-renewable subscription inside it
#      priced at $19.99/mo. Copy its Product ID into both vars below.
#   2. (Optional but recommended) App Store Connect → your app → General
#      → App Store Server Notifications → set the Production/Sandbox URL
#      to https://<your-domain>/api/apple/notifications — keeps renewals/
#      cancellations in sync in real time. No API key needed for this;
#      verification uses Apple's own public root certificate, already
#      committed at server/assets/apple/AppleRootCA-G3.cer.
APPLE_IAP_PRODUCT_ID=
EXPO_PUBLIC_APPLE_IAP_PRODUCT_ID=
# Your app's numeric App Store Connect ID (already used for TestFlight
# submission in eas.json) — only needed if it ever changes.
APPLE_APP_STORE_ID=6800160283

# ── Stripe Identity (seller verification) ───────────────────────────────
# Uses the same STRIPE_SECRET_KEY above — Identity just needs to be enabled
# on your Stripe account (Dashboard → Identity → Get started).

# ── SMS OTP — leave everything below blank to log OTP codes to the server
# console instead of sending real texts, useful for local development. ──

# Vonage (preferred — checked first if both are set). Get API key/secret
# instantly at https://dashboard.nexmo.com/getting-started-guide, no
# compliance-review wait. VONAGE_FROM is an alphanumeric sender name (e.g.
# "PullMarket") — most countries including Australia allow this for
# one-way SMS without buying a dedicated number.
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_FROM=PullMarket

# Twilio (fallback, only used if Vonage isn't configured).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Twilio phone number OTP texts are sent from (E.164, e.g. +18005551234) —
# buy one under Twilio Console → Phone Numbers.
TWILIO_FROM_NUMBER=

# ── Email OTP + owner report forwarding (Resend) ────────────────────────
# Leave blank to log emails to the server console instead of sending them.
# Uses Resend's HTTPS API (https://resend.com), not SMTP — most PaaS hosts
# (including Render) block outbound SMTP ports entirely, so raw SMTP fails
# with a connection timeout regardless of provider/credentials. Sign up at
# resend.com, grab an API key from the dashboard (free tier is plenty for
# OTP volume). SMTP_FROM defaults to Resend's no-setup-required test sender
# (onboarding@resend.dev) — switch it to your own address once you've
# verified a domain in Resend's dashboard.
RESEND_API_KEY=
SMTP_FROM="PullMarket TCG <onboarding@resend.dev>"
# Where reported-listing incidents get emailed to you.
OWNER_REPORT_EMAIL=

# ── Google Sign-In ───────────────────────────────────────────────────────
# Create an OAuth 2.0 Client ID (type "Web application") at
# https://console.cloud.google.com/apis/credentials. Add your live URL(s)
# to "Authorized JavaScript origins" (redirect URIs can stay blank — the
# web flow uses Google's popup code flow, not a redirect).
GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# The same OAuth client's secret — needed server-side to exchange the
# popup's authorization code for tokens. Keep this one server-only, never
# prefix it with EXPO_PUBLIC_.
GOOGLE_CLIENT_SECRET=
# Only needed for native (iOS/Android) Sign-In once you build with EAS —
# create separate "iOS"/"Android" type OAuth clients for these.
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# ── Apple Sign-In (web) ───────────────────────────────────────────────────
# A Services ID (separate from the app's Bundle ID) registered at
# https://developer.apple.com/account → Identifiers → Services IDs, with
# "Sign In with Apple" configured: Domains = your web domain(s), Return
# URLs = the matching https:// origin(s). Native iOS sign-in uses the app's
# Bundle ID directly and doesn't need this.
EXPO_PUBLIC_APPLE_SERVICES_ID=

# ── App URLs ──────────────────────────────────────────────────────────
PORT=5050
APP_BASE_URL=http://localhost:5050
EXPO_PUBLIC_API_URL=http://localhost:5050

# ── AI chat moderation (optional) ────────────────────────────────────────
# Get a key from https://console.anthropic.com. Every chat message is
# classified for scam/fraud attempts and abusive language; flagged messages
# still deliver normally but open a report in the Owner Panel for review
# (see server/src/lib/moderation.ts). Leave blank to skip moderation
# entirely — chat works fine without it.
ANTHROPIC_API_KEY=

# ── Object storage for uploads (optional but strongly recommended) ──────
# Leave all of these blank and uploads (avatars, listing photos, chat
# media, scanned card composites) are written to local disk instead —
# fine for development, but Render's free/starter plan wipes local disk
# on every deploy/restart, so anything users uploaded is gone until they
# re-upload it. Setting these switches every upload in the app over to
# S3-compatible object storage with no other changes needed (see
# server/src/lib/objectStorage.ts). Works with:
#  - Cloudflare R2 (recommended — no egress fees, generous free tier):
#    S3_ENDPOINT = https://<account-id>.r2.cloudflarestorage.com
#    S3_PUBLIC_URL_BASE = your bucket's public R2.dev URL or custom domain
#  - Backblaze B2 (S3-compatible mode): S3_ENDPOINT = your region's B2 S3 endpoint
#  - Real AWS S3: leave S3_ENDPOINT blank
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_ENDPOINT=
S3_PUBLIC_URL_BASE=

# ── Live card prices (optional) ──────────────────────────────────────────
# Powers the Prices tab — real market prices for Pokémon and One Piece TCG
# cards from JustTCG (justtcg.com), a third-party TCGPlayer/Cardmarket data
# aggregator (TCGPlayer closed its own API to new developers in 2024).
# Sign up and subscribe to a plan at justtcg.com, then paste the key below.
# Note: their free tier is personal/prototyping use only — showing prices
# to real users (i.e. this app, once deployed) requires a paid plan per
# their terms (see justtcg.com/docs/commercial-use), starting around
# $9.99/mo. Leave blank and the Prices tab shows a clear "not configured"
# message instead of failing silently.
JUSTTCG_API_KEY=
