# --- Required for a working local demo ---
DATABASE_URL=postgres://user:password@localhost:5432/nexaai
JWT_SECRET=replace-with-a-long-random-string
PORT=5060

# --- Real AI chat (Claude). Without this, chat returns a clear placeholder
# instead of a real answer. ---
ANTHROPIC_API_KEY=

# --- Web app URL the mobile client should talk to ---
EXPO_PUBLIC_API_URL=http://localhost:5060

# --- Paddle: website credit-pack checkout ("something other than Stripe").
# Sign up at paddle.com (Billing), create one-time Price objects for each
# pack, set their IDs below, and grab your API key + webhook secret. ---
PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_ID_35=
PADDLE_PRICE_ID_80=
PADDLE_PRICE_ID_115=
PADDLE_PRICE_ID_175=

# --- Apple In-App Purchase (iOS credit purchases inside the app). Needs an
# App Store Connect "In-App Purchase" API key (.p8). ---
APPLE_IAP_KEY_ID=
APPLE_IAP_ISSUER_ID=
APPLE_IAP_PRIVATE_KEY=
APPLE_IAP_BUNDLE_ID=com.nexaai.app
APPLE_IAP_ENVIRONMENT=Sandbox

# --- TrackLine (your own maps app) deep link + App Store listing, once you
# have them. ---
EXPO_PUBLIC_TRACKLINE_URL_SCHEME=trackline://
EXPO_PUBLIC_TRACKLINE_APP_STORE_URL=

# --- Connectors (Settings -> Connectors screen). Google is wired end-to-end;
# the rest are real UI that reports "not configured" until you add these. ---
APP_BASE_URL=http://localhost:5060
GOOGLE_CONNECTOR_CLIENT_ID=
GOOGLE_CONNECTOR_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
