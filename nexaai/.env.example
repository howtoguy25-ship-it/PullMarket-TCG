# --- Required for a working local demo ---
DATABASE_URL=postgres://user:password@localhost:5432/nexaai
JWT_SECRET=replace-with-a-long-random-string
PORT=5060

# --- Real AI chat (Claude). Without this, chat returns a clear placeholder
# instead of a real answer. ---
ANTHROPIC_API_KEY=

# --- Web app URL the mobile client should talk to ---
EXPO_PUBLIC_API_URL=http://localhost:5060

# --- Paddle: website credit-pack checkout ("something other than Stripe").
# Sign up at paddle.com (Billing), create one-time Price objects for each
# pack, set their IDs below, and grab your API key + webhook secret. ---
PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_ID_35=
PADDLE_PRICE_ID_80=
PADDLE_PRICE_ID_115=
PADDLE_PRICE_ID_175=

# --- Apple In-App Purchase (iOS credit purchases inside the app). Needs an
# App Store Connect "In-App Purchase" API key (.p8). ---
APPLE_IAP_KEY_ID=
APPLE_IAP_ISSUER_ID=
APPLE_IAP_PRIVATE_KEY=
APPLE_IAP_BUNDLE_ID=com.nexaai.app
APPLE_IAP_ENVIRONMENT=Sandbox

# --- TrackLine (your own maps app) deep link + App Store listing, once you
# have them. ---
EXPO_PUBLIC_TRACKLINE_URL_SCHEME=trackline://
EXPO_PUBLIC_TRACKLINE_APP_STORE_URL=

# --- Connectors (Settings -> Connectors screen). Google is wired end-to-end;
# the rest are real UI that reports "not configured" until you add these. ---
APP_BASE_URL=http://localhost:5060
GOOGLE_CONNECTOR_CLIENT_ID=
GOOGLE_CONNECTOR_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
# Any random string you choose — must match what you type into Meta's App
# Dashboard when registering the webhook (Settings -> Webhooks).
META_WEBHOOK_VERIFY_TOKEN=

# --- Self-hosted model (Beginner tier — see finetune/). Point this at your
# deployed vLLM endpoint's OpenAI-compatible base URL, e.g.
# http://<your-runpod-ip>:8000/v1. Until this is set, Beginner tier
# transparently falls back to the Anthropic API so the app keeps working
# while you're still training/deploying. ---
SELF_HOSTED_MODEL_BASE_URL=
SELF_HOSTED_MODEL_NAME=nexaai-llama3-8b
SELF_HOSTED_MODEL_API_KEY=

# --- Gemini "speed lane" (see server/src/lib/geminiModel.ts) — powers the
# fast-reasoning step of live voice chat specifically. Not a selectable chat
# provider for Pro/Max; Claude stays the sole premium text model. Uses
# Google's OpenAI-compatible endpoint, so no separate SDK dependency. ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- Real voice chat (server/src/routes/voice.ts, lib/voice/). One key powers
# both stages: OpenAI Whisper for speech-to-text and OpenAI TTS for the
# spoken reply. Without this, voice chat returns a clear "not configured"
# error and the mic recording is never sent anywhere. ---
OPENAI_API_KEY=
OPENAI_STT_MODEL=whisper-1
OPENAI_TTS_MODEL=tts-1

# --- File/photo/video attachments (Chat's paperclip button). Uploads stream
# straight to local disk under nexaai/uploads. Raise this if your host's
# disk/bandwidth budget supports bigger files — see README for why a single
# HTTP request maxing out near 30GB isn't realistic without a resumable
# upload protocol. Default below is 2GB. ---
MAX_UPLOAD_BYTES=2147483648

# --- Fine-tuning pipeline (finetune/ — offline tooling, not used by the
# running app). Generates synthetic training data for your own Llama model.
# Defaults to an open-weight teacher (Together.ai) on purpose — see
# finetune/lib/teacherProvider.ts's header comment before changing
# TEACHER_PROVIDER to "anthropic". ---
TEACHER_PROVIDER=together
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
TEACHER_MODEL=
TEACHER_API_BASE_URL=
