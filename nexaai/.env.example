# --- Required for a working local demo ---
DATABASE_URL=postgres://user:password@localhost:5432/nexaai
JWT_SECRET=replace-with-a-long-random-string
PORT=5080

# --- Real AI chat (Claude). Without this, chat returns a clear placeholder
# instead of a real answer. ---
ANTHROPIC_API_KEY=

# --- Web app URL the mobile client should talk to ---
EXPO_PUBLIC_API_URL=http://localhost:5080

# --- Paddle: website/Android credit-pack + Pro/Max subscription checkout
# ("something other than Stripe"). Sign up at paddle.com (Billing), create
# one-time Price objects for each credit pack and RECURRING Price objects
# for Pro/Max, set their IDs below, and grab your API key + webhook secret. ---
PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_ID_35=
PADDLE_PRICE_ID_80=
PADDLE_PRICE_ID_115=
PADDLE_PRICE_ID_175=
PADDLE_PRICE_ID_PRO=
PADDLE_PRICE_ID_MAX=

# --- Apple In-App Purchase (iOS Pro/Max/Ember plan subscriptions — required
# by App Store Guideline 3.1.1; Paddle/web checkout can't be used inside the
# iOS app for these). Create these Products in App Store Connect (3
# auto-renewable subscriptions) and set their exact Product IDs below — a
# purchase button simply doesn't appear for a tier whose product id isn't
# set. Verification itself needs no API key, just the bundled
# server/assets/apple/AppleRootCA-G3.cer — see lib/payments/appleIap.ts. ---
APPLE_IAP_BUNDLE_ID=com.nexaai.app
APPLE_APP_STORE_ID=
APPLE_IAP_PRO_PRODUCT_ID=
APPLE_IAP_MAX_PRODUCT_ID=

# Credit-pack consumables — kept here for the underlying verify plumbing
# (routes/credits.ts's /apple/verify) that still works, but NOT currently
# wired to any client purchase button: credits are website-only on iOS by
# product decision (see README "Why plans and credits use different
# payment paths"), so leaving these unset is fine and expected.
APPLE_IAP_CREDITS_35_PRODUCT_ID=
APPLE_IAP_CREDITS_80_PRODUCT_ID=
APPLE_IAP_CREDITS_115_PRODUCT_ID=
APPLE_IAP_CREDITS_175_PRODUCT_ID=

# --- TrackLine (your own maps app) deep link + App Store listing, once you
# have them. ---
EXPO_PUBLIC_TRACKLINE_URL_SCHEME=trackline://
EXPO_PUBLIC_TRACKLINE_APP_STORE_URL=

# --- Connectors (Settings -> Connectors screen). Google is wired end-to-end;
# the rest are real UI that reports "not configured" until you add these. ---
# The server's own public URL — used to build OAuth redirect URIs (Google,
# GitHub, Vercel, Netlify, Stripe Connect, SiteSpark) and links in emails.
# The real domain is asknexaai.com (registered, DNS/hosting not live yet).
# Once the server is actually deployed and reachable there, change this to
# https://asknexaai.com and update the redirect URI registered with each
# OAuth provider to match — until then leave it as the local dev value below,
# so local development keeps working against localhost.
APP_BASE_URL=http://localhost:5080

# --- Social sign-in on the Auth screen (distinct from the Connectors below
# — those ask an already-signed-in account for extra access; these are the
# actual "Continue with ___" login buttons). See server/src/lib/socialAuth/
# for each provider's real setup steps.
# Apple needs nothing here — it verifies against Apple's own public keys,
# and the "Sign In with Apple" capability is already enabled on the real
# com.nexaai.chat bundle ID.
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=
GITHUB_AUTH_CLIENT_ID=
GITHUB_AUTH_CLIENT_SECRET=

# Real phone sign-in (server/src/lib/socialAuth/phone.ts) — sends an actual
# SMS one-time code via Twilio Verify. console.twilio.com -> Verify ->
# Services -> create a Service -> copy its SID. Distinct from the per-user
# Twilio connector further below (that's a user's own account, for
# receiving calls on their own number).
TWILIO_VERIFY_ACCOUNT_SID=
TWILIO_VERIFY_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Real "forgot password" email (server/src/lib/email.ts) via Resend.
# resend.com -> API Keys -> Create API Key. RESEND_FROM_EMAIL defaults to
# Resend's own onboarding@resend.dev sender until you verify asknexaai.com
# as a domain on your Resend account.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

GOOGLE_CONNECTOR_CLIENT_ID=
GOOGLE_CONNECTOR_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# From Slack app -> Basic Information -> App Credentials. Verifies inbound
# Events API requests are genuinely from Slack (routes/webhooks/slack.ts).
SLACK_SIGNING_SECRET=
# From your X Developer app's Keys and Tokens (OAuth 2.0 Client ID/Secret) —
# see server/src/lib/connectors/x.ts's header for the scopes/setup needed.
# Real per-action billing applies once connected (X's pay-per-use tier).
X_CLIENT_ID=
X_CLIENT_SECRET=
# How often (ms) the X DM poller checks for new messages per connected
# account — see lib/agents/xPoller.ts's header for why 90s is the default.
X_DM_POLL_INTERVAL_MS=90000
# One Meta Developer app powers all three agent-builder platforms —
# Instagram DMs, Facebook Page Messenger, and WhatsApp Cloud API — no
# separate credentials needed per platform.
META_APP_ID=
META_APP_SECRET=
# Any random string you choose — must match what you type into Meta's App
# Dashboard when registering the webhook (Settings -> Webhooks).
META_WEBHOOK_VERIFY_TOKEN=

# --- SiteSpark connector (Connectors -> SiteSpark). Generic OAuth2 client
# pointed at your own SiteSpark app's OAuth + site-import endpoints — see
# server/src/lib/connectors/sitespark.ts's header for the exact endpoints
# SiteSpark itself needs to implement before this can connect and export
# Project builds for real. ---
SITESPARK_CLIENT_ID=
SITESPARK_CLIENT_SECRET=
SITESPARK_OAUTH_BASE_URL=
# SiteSpark's API host for the real site-import call a Project's "Export to
# SiteSpark" button makes (POST /api/v1/sites/import) — often the same host
# as SITESPARK_OAUTH_BASE_URL above, but kept separate in case your OAuth
# and API hosts differ.
SITESPARK_API_BASE_URL=
# Platform-level secret (sisp_live_...) from your SiteSpark dashboard —
# identifies NexaAi itself as the calling app on the site-import call,
# sent as X-Api-Key alongside the per-user OAuth token. Rotate it in
# SiteSpark's dashboard if it's ever been exposed; never commit the real value.
SITESPARK_API_KEY=

# --- GitHub connector (push a Project's generated code to a real repo).
# Create an OAuth App at github.com/settings/developers. ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Vercel connector (one-click deploy). Create an Integration in Vercel's
# dashboard (vercel.com/dashboard/integrations/console). ---
VERCEL_CLIENT_ID=
VERCEL_CLIENT_SECRET=
VERCEL_INTEGRATION_SLUG=

# --- Netlify connector (one-click deploy). Create an OAuth App at
# app.netlify.com/user/applications. ---
NETLIFY_CLIENT_ID=
NETLIFY_CLIENT_SECRET=

# --- Stripe connector (real payments in a site you build). Enable Connect
# OAuth in your Stripe dashboard, then use your platform's own secret key
# (not the connected account's) to redeem the OAuth code. ---
STRIPE_CLIENT_ID=
STRIPE_SECRET_KEY=

# --- Namecheap connector: manual entry, no env vars needed — the user
# pastes their own API key/username/whitelisted IP in the app. ---

# --- Twilio connector (real phone number people can call to talk to
# NexaAi): manual entry too, no env vars needed — the user pastes their own
# Account SID / Auth Token / phone number in the app. NexaAi auto-configures
# that number's Voice webhook against APP_BASE_URL above, so APP_BASE_URL
# must be a real, publicly reachable URL for inbound calls to work — see
# server/src/lib/connectors/twilio.ts's header for the exact setup steps. ---

# --- Owner panel (Settings -> Owner on the website). Allowlist check on the
# logged-in account's own email/phone — no separate login. ---
OWNER_EMAIL=
OWNER_PHONE=

# --- Self-hosted model (Beginner tier — see finetune/). Point this at your
# deployed vLLM endpoint's OpenAI-compatible base URL, e.g.
# http://<your-runpod-ip>:8000/v1. Until this is set, Beginner tier
# transparently falls back to the Anthropic API so the app keeps working
# while you're still training/deploying. ---
SELF_HOSTED_MODEL_BASE_URL=
SELF_HOSTED_MODEL_NAME=nexaai-llama3-8b
SELF_HOSTED_MODEL_API_KEY=

# --- Gemini "speed lane" (see server/src/lib/geminiModel.ts) — powers the
# fast-reasoning step of live voice chat specifically. Not a selectable chat
# provider for Pro/Max; Claude stays the sole premium text model. Uses
# Google's OpenAI-compatible endpoint, so no separate SDK dependency. ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- Real voice chat (server/src/routes/voice.ts, lib/voice/). One key powers
# both stages: OpenAI Whisper for speech-to-text and OpenAI TTS for the
# spoken reply. Without this, voice chat returns a clear "not configured"
# error and the mic recording is never sent anywhere. ---
OPENAI_API_KEY=
OPENAI_STT_MODEL=whisper-1
OPENAI_TTS_MODEL=tts-1

# --- File/photo/video attachments (Chat's paperclip button). Uploads stream
# straight to local disk under nexaai/uploads. Raise this if your host's
# disk/bandwidth budget supports bigger files — see README for why a single
# HTTP request maxing out near 30GB isn't realistic without a resumable
# upload protocol. Default below is 2GB. ---
MAX_UPLOAD_BYTES=2147483648

# --- Fine-tuning pipeline (finetune/ — offline tooling, not used by the
# running app). Generates synthetic training data for your own Llama model.
# Defaults to an open-weight teacher (Together.ai) on purpose — see
# finetune/lib/teacherProvider.ts's header comment before changing
# TEACHER_PROVIDER to "anthropic". ---
TEACHER_PROVIDER=together
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
TEACHER_MODEL=
TEACHER_API_BASE_URL=
