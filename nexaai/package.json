{
  "name": "nexaai",
  "private": true,
  "version": "0.1.0",
  "main": "client/index.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev:client": "expo start --web",
    "dev:server": "NODE_ENV=development tsx server/src/index.ts",
    "dev": "concurrently -n client,server -c blue,green \"npm:dev:client\" \"npm:dev:server\"",
    "web:build": "expo export --platform web --output-dir web-build",
    "server:build": "esbuild server/src/index.ts --platform=node --packages=external --bundle --format=cjs --outdir=server-dist --tsconfig=tsconfig.json",
    "server:start": "NODE_ENV=production node server-dist/index.js",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "check:types": "tsc --noEmit",
    "seed": "tsx server/src/scripts/seed.ts",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "finetune:generate": "tsx finetune/generateSyntheticData.ts",
    "finetune:validate": "tsx finetune/validateDataset.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@apple/app-store-server-library": "^3.1.0",
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@expo/vector-icons": "^15.0.2",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/native": "^7.1.8",
    "@react-navigation/native-stack": "^7.3.16",
    "@tanstack/react-query": "^5.90.7",
    "babel-preset-expo": "^54.0.10",
    "bcryptjs": "^3.0.3",
    "dictionary-en": "^4.0.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.39.3",
    "expo": "~54.0.36",
    "expo-apple-authentication": "~8.0.8",
    "expo-av": "~16.0.8",
    "expo-calendar": "~15.0.8",
    "expo-camera": "^17.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.9",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.8",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-speech": "~14.0.7",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.20",
    "expo-web-browser": "~15.0.11",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.3.0",
    "nspell": "^2.1.5",
    "pdf-parse": "^2.4.5",
    "pg": "^8.16.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-iap": "^16.3.0",
    "react-native-markdown-display": "^7.0.2",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-view-shot": "4.0.3",
    "react-native-web": "~0.21.0",
    "zod": "^3.25.76",
    "babel-plugin-module-resolver": "^5.0.2",
    "drizzle-kit": "^0.31.4",
    "esbuild": "^0.25.12"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "22.10.0",
    "@types/nspell": "^2.1.6",
    "@types/pg": "^8.11.10",
    "@types/react": "~19.1.0",
    "concurrently": "^9.1.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
